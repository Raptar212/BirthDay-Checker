<Window x:Class="BirthdayChecker.App.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BirthDay Checker — напоминание"
        Width="380" SizeToContent="Height" MaxHeight="600"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
            <Button Style="{StaticResource MainButton}" DockPanel.Dock="Right" Content="Закрыть" IsCancel="True" VerticalAlignment="Bottom" Click="OnClose"/>
            <StackPanel DockPanel.Dock="Left">
                <Button Style="{StaticResource MainButton}" Content="Напомнить позже" ToolTip="Через час" Margin="0,0,0,6" Click="OnSnoozeAll"/>
                <Button Style="{StaticResource MainButton}" Content="Больше не напоминать сегодня" Click="OnDismissAll"/>
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Items"/>
        </ScrollViewer>
    </DockPanel>
</Window>
